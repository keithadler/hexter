@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .
@prefix work:  <http://lv2plug.in/ns/ext/worker#> .
@prefix hex:   <https://github.com/keithadler/hexter#> .

hex:bank
    a lv2:Parameter ;
    rdfs:label "Bank file" ;
    rdfs:comment "A DX7 bank: .syx, .dx7, .mid, .tx7, .snd, .bnk, .dx2 or raw packed voices. Loaded into programs 1-128." ;
    rdfs:range atom:Path .

<https://github.com/keithadler/hexter>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "hexter" ;
    doap:license <http://opensource.org/licenses/gpl-2.0> ;
    doap:maintainer [
        foaf:name "Keith Adler" ;
        foaf:homepage <https://github.com/keithadler/hexter>
    ] ;
    doap:developer [
        foaf:name "Sean Bolton"
    ] ;
    rdfs:comment "Yamaha DX7 modeling FM synthesizer. Loads DX7 banks and answers to DX7 sysex." ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable , work:schedule , state:mapPath ;
    lv2:extensionData state:interface , work:interface ;
    patch:writable hex:bank ;
    lv2:port [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control"
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 1 ;
        lv2:symbol "notify" ;
        lv2:name "Notify"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out" ;
        lv2:name "Output"
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "tuning" ;
        lv2:name "Tuning" ;
        lv2:default 440.0 ;
        lv2:minimum 415.3 ;
        lv2:maximum 466.2 ;
        units:unit units:hz
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "volume" ;
        lv2:name "Volume" ;
        lv2:default 0.0 ;
        lv2:minimum -70.0 ;
        lv2:maximum 20.0 ;
        units:unit units:db
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "polyphony" ;
        lv2:name "Polyphony" ;
        lv2:portProperty lv2:integer ;
        lv2:default 10 ;
        lv2:minimum 1 ;
        lv2:maximum 64
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "voice_mode" ;
        lv2:name "Voice mode" ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:scalePoint [ rdfs:label "Poly" ; rdf:value 0 ] ,
                       [ rdfs:label "Mono" ; rdf:value 1 ] ,
                       [ rdfs:label "Mono legato" ; rdf:value 2 ] ,
                       [ rdfs:label "Mono both" ; rdf:value 3 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "program" ;
        lv2:name "Program" ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 127
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "algorithm" ;
        lv2:name "Algorithm" ;
        rdfs:comment "Forces the patch's DX7 algorithm, 1-32. At 0 the patch plays its own. Moving it is heard on notes already held; selecting a program brings the patch's own algorithm back." ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 32 ;
        lv2:scalePoint [ rdfs:label "Patch" ; rdf:value 0 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "op1_wave" ;
        lv2:name "OP1 wave" ;
        rdfs:comment "The waveform operator 1 plays: 1 is the sine a DX7 has, 2 to 8 the other shapes the TX81Z and its relatives can pick. At 0 the operator keeps whatever the patch gave it, which for a converted TX81Z voice is a shape of its own. Moving it is heard on notes already held; selecting a program brings the patch's own shapes back." ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        lv2:scalePoint [ rdfs:label "Patch" ; rdf:value 0 ] ,
                       [ rdfs:label "W1 sine" ; rdf:value 1 ] ,
                       [ rdfs:label "W2" ; rdf:value 2 ] ,
                       [ rdfs:label "W3" ; rdf:value 3 ] ,
                       [ rdfs:label "W4" ; rdf:value 4 ] ,
                       [ rdfs:label "W5" ; rdf:value 5 ] ,
                       [ rdfs:label "W6" ; rdf:value 6 ] ,
                       [ rdfs:label "W7" ; rdf:value 7 ] ,
                       [ rdfs:label "W8" ; rdf:value 8 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "op2_wave" ;
        lv2:name "OP2 wave" ;
        rdfs:comment "The waveform operator 2 plays: 1 is the sine a DX7 has, 2 to 8 the other shapes the TX81Z and its relatives can pick. At 0 the operator keeps whatever the patch gave it, which for a converted TX81Z voice is a shape of its own. Moving it is heard on notes already held; selecting a program brings the patch's own shapes back." ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        lv2:scalePoint [ rdfs:label "Patch" ; rdf:value 0 ] ,
                       [ rdfs:label "W1 sine" ; rdf:value 1 ] ,
                       [ rdfs:label "W2" ; rdf:value 2 ] ,
                       [ rdfs:label "W3" ; rdf:value 3 ] ,
                       [ rdfs:label "W4" ; rdf:value 4 ] ,
                       [ rdfs:label "W5" ; rdf:value 5 ] ,
                       [ rdfs:label "W6" ; rdf:value 6 ] ,
                       [ rdfs:label "W7" ; rdf:value 7 ] ,
                       [ rdfs:label "W8" ; rdf:value 8 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "op3_wave" ;
        lv2:name "OP3 wave" ;
        rdfs:comment "The waveform operator 3 plays: 1 is the sine a DX7 has, 2 to 8 the other shapes the TX81Z and its relatives can pick. At 0 the operator keeps whatever the patch gave it, which for a converted TX81Z voice is a shape of its own. Moving it is heard on notes already held; selecting a program brings the patch's own shapes back." ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        lv2:scalePoint [ rdfs:label "Patch" ; rdf:value 0 ] ,
                       [ rdfs:label "W1 sine" ; rdf:value 1 ] ,
                       [ rdfs:label "W2" ; rdf:value 2 ] ,
                       [ rdfs:label "W3" ; rdf:value 3 ] ,
                       [ rdfs:label "W4" ; rdf:value 4 ] ,
                       [ rdfs:label "W5" ; rdf:value 5 ] ,
                       [ rdfs:label "W6" ; rdf:value 6 ] ,
                       [ rdfs:label "W7" ; rdf:value 7 ] ,
                       [ rdfs:label "W8" ; rdf:value 8 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "op4_wave" ;
        lv2:name "OP4 wave" ;
        rdfs:comment "The waveform operator 4 plays: 1 is the sine a DX7 has, 2 to 8 the other shapes the TX81Z and its relatives can pick. At 0 the operator keeps whatever the patch gave it, which for a converted TX81Z voice is a shape of its own. Moving it is heard on notes already held; selecting a program brings the patch's own shapes back." ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        lv2:scalePoint [ rdfs:label "Patch" ; rdf:value 0 ] ,
                       [ rdfs:label "W1 sine" ; rdf:value 1 ] ,
                       [ rdfs:label "W2" ; rdf:value 2 ] ,
                       [ rdfs:label "W3" ; rdf:value 3 ] ,
                       [ rdfs:label "W4" ; rdf:value 4 ] ,
                       [ rdfs:label "W5" ; rdf:value 5 ] ,
                       [ rdfs:label "W6" ; rdf:value 6 ] ,
                       [ rdfs:label "W7" ; rdf:value 7 ] ,
                       [ rdfs:label "W8" ; rdf:value 8 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "op5_wave" ;
        lv2:name "OP5 wave" ;
        rdfs:comment "The waveform operator 5 plays: 1 is the sine a DX7 has, 2 to 8 the other shapes the TX81Z and its relatives can pick. At 0 the operator keeps whatever the patch gave it, which for a converted TX81Z voice is a shape of its own. Moving it is heard on notes already held; selecting a program brings the patch's own shapes back." ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        lv2:scalePoint [ rdfs:label "Patch" ; rdf:value 0 ] ,
                       [ rdfs:label "W1 sine" ; rdf:value 1 ] ,
                       [ rdfs:label "W2" ; rdf:value 2 ] ,
                       [ rdfs:label "W3" ; rdf:value 3 ] ,
                       [ rdfs:label "W4" ; rdf:value 4 ] ,
                       [ rdfs:label "W5" ; rdf:value 5 ] ,
                       [ rdfs:label "W6" ; rdf:value 6 ] ,
                       [ rdfs:label "W7" ; rdf:value 7 ] ,
                       [ rdfs:label "W8" ; rdf:value 8 ]
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "op6_wave" ;
        lv2:name "OP6 wave" ;
        rdfs:comment "The waveform operator 6 plays: 1 is the sine a DX7 has, 2 to 8 the other shapes the TX81Z and its relatives can pick. At 0 the operator keeps whatever the patch gave it, which for a converted TX81Z voice is a shape of its own. Moving it is heard on notes already held; selecting a program brings the patch's own shapes back." ;
        lv2:portProperty lv2:integer ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 8 ;
        lv2:scalePoint [ rdfs:label "Patch" ; rdf:value 0 ] ,
                       [ rdfs:label "W1 sine" ; rdf:value 1 ] ,
                       [ rdfs:label "W2" ; rdf:value 2 ] ,
                       [ rdfs:label "W3" ; rdf:value 3 ] ,
                       [ rdfs:label "W4" ; rdf:value 4 ] ,
                       [ rdfs:label "W5" ; rdf:value 5 ] ,
                       [ rdfs:label "W6" ; rdf:value 6 ] ,
                       [ rdfs:label "W7" ; rdf:value 7 ] ,
                       [ rdfs:label "W8" ; rdf:value 8 ]
    ] .
