<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Spinner android:id="@+id/banks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <Button android:id="@+id/open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/open_bank" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
    <TextView android:id="@+id/midiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:text="@string/no_midi" />
    <ListView android:id="@+id/programs" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fontFamily="monospace" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/volume" />
        <SeekBar android:id="@+id/volume" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <TextView android:id="@+id/level" android:layout_width="120dp" android:layout_height="wrap_content" android:textColor="#FF8C00" android:fontFamily="monospace" />
    </LinearLayout>
    <org.keithadler.hexter.KeyboardView android:id="@+id/keyboard" android:layout_width="match_parent" android:layout_height="150dp" />
</LinearLayout>
